---
/*
 * 404。
 *
 * これが無いと Cloudflare Pages は存在しない URL にトップページの中身を
 * 200 で返してしまう（pages.dev で確認済み）。タイプミスや古いリンクで
 * 来た人に「正しいページ」として profile が出るし、検索エンジンにも
 * 存在しない URL が有効として扱われる。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="ページが見つかりませんでした。">
  <div class="notfound">
    <h1>404</h1>
    <p>お探しのページは見つかりませんでした。</p>
    <p class="back"><a href="/">トップへ</a></p>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: 3rem 4rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 2.5rem;
    letter-spacing: 0.1em;
  }

  p {
    margin-block: 1.5rem;
  }

  .back {
    font-size: 0.9rem;
  }
</style>
