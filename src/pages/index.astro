---
/*
 * プロフィールの 1 ページ。
 *
 * セクションの順番そのものに役割がある：
 *   ①hero  10 秒で判断する層。ここで X を出し、戻らずフォローできるようにする
 *   ②now   進行中のもの。「応援したくなる」はここに向く
 *   ③works 何が流れてくるかの予測材料。各媒体への導線もここが兼ねる
 *   ④history 盛らない事実。誠実さと、就活で見られたときの担保
 *   ⑤contact + 最終更新日
 *
 * 順番を入れ替えるときは、上の意図ごと考え直すこと。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { intro, now, works, history, primaryLink, contact, updatedAt } from '../data/profile';
import { getLatestPosts } from '../lib/blog-posts';

/* 媒体ごとに 2 件ずつ。ブログもそれに揃える */
const posts = await getLatestPosts(2);

const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout>
  <section class="hero">
    {
      intro.avatar ? (
        <img class="avatar" src={intro.avatar} alt="" width="96" height="96" />
      ) : (
        /* アイコン画像が用意できるまでの仮置き。サイトの差し色をそのまま使う */
        <div class="avatar avatar--placeholder" aria-hidden="true" />
      )
    }

    <h1>{intro.name}</h1>
    <p class="reading">{intro.reading}</p>

    <p class="tagline">
      {intro.tagline}<br />
      {intro.taglineSub}
    </p>

    {/*
      ページ内で唯一の塗りボタン。他をすべて静かにしてあるので、
      「次にしてほしいこと」がここだと迷わず分かる。
    */}
    <a class="cta" href={primaryLink.url} rel="me noopener noreferrer">
      {primaryLink.label} をフォロー
    </a>
    <p class="cta-note">{primaryLink.description}</p>
  </section>

  <section>
    <h2>いま</h2>
    <ul class="now">
      {
        now.map((item) => (
          <li>
            {item.text}
            {item.note && <span class="note">{item.note}</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>つくっているもの</h2>
    {
      works.map((work) => {
        /*
         * ブログは RSS から、それ以外は本人が選んだものを出す。
         * RSS の取得に失敗したらブログの項目は 0 件になるので、
         * そのときは媒体への導線だけ残す（空の枠は出さない）。
         */
        const entries = work.latest
          ? posts.map((post) => ({
              title: post.title,
              url: post.url,
              date: post.date,
            }))
          : (work.picks ?? []).map((pick) => ({ ...pick, date: null }));

        return (
          <div class="work">
            <h3>
              <a href={work.url} rel="noopener noreferrer">
                {work.medium}
              </a>
            </h3>

            {entries.length > 0 && (
              <ul class="entries">
                {entries.map((entry) => (
                  <li>
                    {entry.date && (
                      <time datetime={entry.date.toISOString()}>
                        {dateFormatter.format(entry.date)}
                      </time>
                    )}
                    <a href={entry.url} rel="noopener noreferrer">
                      {entry.title}
                    </a>
                    {'note' in entry && entry.note && <span class="note">{entry.note}</span>}
                    {/*
                      コードを指す項目で、実物が別の場所にあるときの導線。
                      note は素のテキストなのでリンクを書けず、欄を分けている。
                    */}
                    {'demo' in entry && entry.demo && (
                      <a class="demo" href={entry.demo.url} rel="noopener noreferrer">
                        {entry.demo.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })
    }
  </section>

  <section>
    <h2>これまで</h2>
    <ul class="history">
      {
        history.map((item) => (
          <li>
            <span class="year">{item.year}</span>
            <span>{item.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    id を付けているのは、blog.kazuki.page の _redirects にある /contact/ を
    ここへ向けられるようにするため。旧サイトに問い合わせページは無く、
    暫定でトップに送っていた
  */}
  <section id="contact">
    <h2>連絡</h2>
    <p>
      {contact.text}<br />
      <a href={contact.url} rel="noopener noreferrer">{contact.url}</a>
    </p>
    {/* 「生きているサイト」であることを示す一行。誠実さの伝達効率が高い */}
    <p class="updated">最終更新：{updatedAt}</p>
  </section>
</BaseLayout>

<style>
  section {
    margin-block: 3.5rem;
  }

  h2 {
    font-size: 1.05rem;
    margin-block: 0 1rem;
    padding-bottom: 0.5rem;
    /* ブログの h2 と同じ「少し内側で絞る下線」 */
    position: relative;
  }

  h2::after {
    content: '';
    position: absolute;
    inset-inline: 0.65rem;
    bottom: 0;
    border-bottom: 1px solid var(--border);
  }

  h3 {
    font-size: 0.95rem;
    color: var(--muted);
    margin-block: 2rem 0.75rem;
  }

  /* --- ①hero ------------------------------------------------------- */

  .hero {
    text-align: center;
    margin-block: 2rem 4rem;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar--placeholder {
    margin-inline: auto;
    background: conic-gradient(
      from 210deg,
      var(--stripe-lightblue),
      var(--stripe-yellow),
      var(--stripe-navy),
      var(--stripe-lightblue)
    );
  }

  .hero h1 {
    font-size: 1.5rem;
    margin-block: 1.25rem 0;
  }

  .reading {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .tagline {
    margin-block: 1.5rem;
    line-height: 2;
    /* 「配信して。」だけが 1 行に取り残されるのを防ぐ */
    text-wrap: balance;
  }

  .cta {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.7rem 1.6rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.95rem;
  }

  .cta:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  .cta-note {
    margin-block: 0.9rem 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* --- リスト共通 ---------------------------------------------------- */

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.7;
  }

  /* --- ②now --------------------------------------------------------- */

  .now li {
    position: relative;
    padding-inline-start: 1.5rem;
    margin-block: 0.9rem;
  }

  /* 「進行中」を示す小さな点。中黒やハイフンより動きが出る */
  .now li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.35rem;
    top: 0.75em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--stripe-yellow);
  }

  /* --- ③works ------------------------------------------------------- */

  /*
   * 媒体を見出しにして、その下に実物を 2 件ずつ。
   * 媒体どうしは罫線ではなく余白で分ける。4 つ並ぶので、
   * 線を引くと表のように見えて「作品を見せる場」に読めなくなる。
   */
  .work {
    margin-block: 1.75rem;
  }

  .work h3 {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  /*
   * 媒体名は青くしない。ここで青を使うと、見出しと中身の作品名が
   * 同じ強さになって、どちらを見ればいいのか分からなくなる。
   * 見出しは構造、青くなっている作品名が本体、という並びにする。
   * （global.css でナビゲーションのリンクを黒のままにしているのと同じ考え方）
   */
  .work h3 a {
    color: inherit;
  }

  .work h3 a:hover {
    color: var(--accent);
  }

  .entries li {
    margin-block: 0.5rem;
    padding-inline-start: 0.9rem;
    font-size: 0.9rem;
    /* 見出しの媒体と、その中身であることが分かる程度の段差 */
    border-inline-start: 1px solid var(--border);
  }

  /* 日付が入るのはブログだけ。これが「新着」と「選んだもの」の目印になる */
  .entries time {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
  }

  /*
   * 稼働しているものへの導線。作品名より一段弱くする。
   * ここが主役になると、何を見てほしいのかがぼやける。
   */
  .demo {
    display: inline-block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
  }

  .demo::after {
    /* 別の場所へ出ることを示す。外部リンクであることの合図 */
    content: ' ↗';
  }

  /* --- ④history ----------------------------------------------------- */

  .history li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-block: 0.6rem;
  }

  .year {
    flex: none;
    width: 3.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* --- ⑤contact ----------------------------------------------------- */

  .updated {
    margin-block: 2rem 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
