---
/*
 * プロフィールの 1 ページ。
 *
 * セクションの順番そのものに役割がある：
 *   ①hero  10 秒で判断する層。ここで X を出し、戻らずフォローできるようにする
 *   ②now   進行中のもの。「応援したくなる」はここに向く
 *   ③apps  つくったもの。実物が 3 つ並ぶ、このサイトで一番強いところ
 *   ④blog  何が流れてくるかの予測材料。更新が生きていることも示す
 *   ⑤other YouTube と pixiv。存在が伝わればよく、中身は現地で見てもらう
 *   ⑥history 盛らない事実。誠実さと、就活で見られたときの担保
 *   ⑦contact + 最終更新日
 *
 * 順番を入れ替えるときは、上の意図ごと考え直すこと。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { intro, now, apps, blog, otherLinks, history, primaryLink, contact, updatedAt } from '../data/profile';
import { getLatestPosts } from '../lib/blog-posts';

const posts = await getLatestPosts(blog.limit, blog.maxRoutine);

const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout>
  <section class="hero">
    {
      intro.avatar ? (
        <img class="avatar" src={intro.avatar} alt="" width="96" height="96" />
      ) : (
        /* アイコン画像が用意できるまでの仮置き。サイトの差し色をそのまま使う */
        <div class="avatar avatar--placeholder" aria-hidden="true" />
      )
    }

    <h1>{intro.name}</h1>
    <p class="reading">{intro.reading}</p>

    <p class="tagline">
      {intro.tagline}<br />
      {intro.taglineSub}
    </p>

    {/*
      ページ内で唯一の塗りボタン。他をすべて静かにしてあるので、
      「次にしてほしいこと」がここだと迷わず分かる。
    */}
    <a class="cta" href={primaryLink.url} rel="me noopener noreferrer">
      {primaryLink.label} をフォロー
    </a>
    <p class="cta-note">{primaryLink.description}</p>
  </section>

  <section>
    <h2>いま</h2>
    <ul class="now">
      {
        now.map((item) => (
          <li>
            {item.text}
            {item.note && <span class="note">{item.note}</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>つくったもの</h2>
    {
      apps.map((app) => (
        <article class="app">
          {/*
            カード全体がデモへのリンク。作品名だけを小さくリンクにするより、
            「押せば動くものが見られる」が迷いなく伝わる。
          */}
          <a class="shot" href={app.demo} rel="noopener noreferrer">
            <img src={app.image} alt={app.alt} width="1200" height="630" loading="lazy" />
          </a>

          <div class="app-foot">
            <h3>{app.name}</h3>
            <p class="app-links">
              <a href={app.demo} rel="noopener noreferrer">デモを見る</a>
              {/* public にしていないものは repo を持たせていない。404 を出さない */}
              {app.repo && <a href={app.repo} rel="noopener noreferrer">コード</a>}
            </p>
          </div>
        </article>
      ))
    }
  </section>

  {/*
    RSS が引けなかったときはセクションごと出さない。
    空の枠が残るより、無いほうが「止まっている」に見えない。
  */}
  {posts.length > 0 && (
    <section>
      <h2>ブログ</h2>
      <ul class="entries">
        {posts.map((post) => (
          <li>
            <time datetime={post.date.toISOString()}>{dateFormatter.format(post.date)}</time>
            <a href={post.url} rel="noopener noreferrer">{post.title}</a>
          </li>
        ))}
      </ul>
      <p class="more">
        <a href={blog.url} rel="noopener noreferrer">blog.kazuki.page</a>
      </p>
    </section>
  )}

  <section>
    <h2>そのほか</h2>
    <ul class="other">
      {
        otherLinks.map((link) => (
          <li>
            <a href={link.url} rel="noopener noreferrer">{link.label}</a>
            <span class="note">{link.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>これまで</h2>
    <ul class="history">
      {
        history.map((item) => (
          <li>
            <span class="year">{item.year}</span>
            <span>{item.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    id を付けているのは、blog.kazuki.page の _redirects にある /contact/ を
    ここへ向けられるようにするため。旧サイトに問い合わせページは無く、
    暫定でトップに送っていた
  */}
  <section id="contact">
    <h2>連絡</h2>
    <p>
      {contact.text}<br />
      <a href={contact.url} rel="noopener noreferrer">{contact.url}</a>
    </p>
    {/* 「生きているサイト」であることを示す一行。誠実さの伝達効率が高い */}
    <p class="updated">最終更新：{updatedAt}</p>
  </section>
</BaseLayout>

<style>
  section {
    margin-block: 3.5rem;
  }

  h2 {
    font-size: 1.05rem;
    margin-block: 0 1rem;
    padding-bottom: 0.5rem;
    /* ブログの h2 と同じ「少し内側で絞る下線」 */
    position: relative;
  }

  h2::after {
    content: '';
    position: absolute;
    inset-inline: 0.65rem;
    bottom: 0;
    border-bottom: 1px solid var(--border);
  }

  h3 {
    font-size: 0.95rem;
    color: var(--muted);
    margin-block: 2rem 0.75rem;
  }

  /* --- ①hero ------------------------------------------------------- */

  .hero {
    text-align: center;
    margin-block: 2rem 4rem;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar--placeholder {
    margin-inline: auto;
    background: conic-gradient(
      from 210deg,
      var(--stripe-lightblue),
      var(--stripe-yellow),
      var(--stripe-navy),
      var(--stripe-lightblue)
    );
  }

  .hero h1 {
    font-size: 1.5rem;
    margin-block: 1.25rem 0;
  }

  .reading {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .tagline {
    margin-block: 1.5rem;
    line-height: 2;
    /* 「配信して。」だけが 1 行に取り残されるのを防ぐ */
    text-wrap: balance;
  }

  .cta {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.7rem 1.6rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.95rem;
  }

  .cta:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  .cta-note {
    margin-block: 0.9rem 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* --- リスト共通 ---------------------------------------------------- */

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.7;
  }

  /* --- ②now --------------------------------------------------------- */

  .now li {
    position: relative;
    padding-inline-start: 1.5rem;
    margin-block: 0.9rem;
  }

  /* 「進行中」を示す小さな点。中黒やハイフンより動きが出る */
  .now li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.35rem;
    top: 0.75em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--stripe-yellow);
  }

  /* --- ③apps -------------------------------------------------------- */

  /*
   * 各アプリの OGP 画像をそのまま並べる。
   * 画像の中にタグラインも技術スタックも入っているので、下に足すのは
   * 作品名と導線だけでいい。説明文を書くと画像と二重になる。
   */
  .app {
    margin-block: 2rem;
  }

  .shot {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    /* 淡い背景の画像（daifuku）が地の白に溶けないよう縁を引く */
    border: 1px solid var(--border);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    /*
     * 1200×630 をそのまま出すと 1 枚 336px、3 枚で 1000px を超えて
     * 1 ページものとしては重い。3 枚とも上下に 1 割ほど余白があるので、
     * そこだけ削って中身（ロゴも UI モックも）は残す。
     */
    aspect-ratio: 1200 / 500;
    object-fit: cover;
  }

  .shot:hover {
    border-color: var(--accent);
  }

  .app-foot {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.6rem;
  }

  .app-foot h3 {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text);
  }

  /* 導線は作品名より一段弱く。押す先が 2 つあっても迷わない程度に小さく */
  .app-links {
    margin: 0;
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    flex: none;
  }

  .app-links a::after {
    /* 別の場所へ出ることを示す。外部リンクであることの合図 */
    content: ' ↗';
  }

  /* --- ④blog -------------------------------------------------------- */

  .entries li {
    margin-block: 0.75rem;
    padding-inline-start: 0.9rem;
    font-size: 0.9rem;
    border-inline-start: 1px solid var(--border);
  }

  .entries time {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .more {
    margin-block: 1.25rem 0;
    font-size: 0.8rem;
  }

  /* --- ⑤other ------------------------------------------------------- */

  /*
   * ここは「やっている」ことが伝わればよい。
   * アプリと同じ密度で見せると、何を見てほしいのかがぼやける。
   */
  .other li {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    margin-block: 0.6rem;
    font-size: 0.9rem;
  }

  .other .note {
    display: inline;
    font-size: 0.8rem;
  }

  /* --- ④history ----------------------------------------------------- */

  .history li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-block: 0.6rem;
  }

  .year {
    flex: none;
    width: 3.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* --- ⑤contact ----------------------------------------------------- */

  .updated {
    margin-block: 2rem 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
